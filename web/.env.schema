# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# @generateTsTypes(path='env.d.ts')
# @defaultSensitive=false
# ---

NODE_ENV=development

# @sensitive
DATABASE_URL=postgres://postgres:postgres@localhost:5432/db

# Bitwarden Secrets Manager Access Token (Set this in your production environment / Coolify)
# @sensitive @optional
BITWARDEN_ACCESS_TOKEN=

# Resend API Key (can be provided directly or fetched via Bitwarden in .env.production / Coolify)
# @sensitive @optional
RESEND_API_KEY=
